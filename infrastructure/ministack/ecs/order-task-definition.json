{
    "family": "logistics-order-service",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "256",
    "memory": "512",
    "containerDefinitions": [
      {
        "name": "order-service",
        "image": "localhost:4566/logistics-order-service:latest",
        "essential": true,
        "portMappings": [
          {
            "containerPort": 8080,
            "protocol": "tcp"
          }
        ],
        "environment": [
          {
            "name": "DATABASE_URL",
            "value": "postgres://logistics:logistics@postgres:5432/logistics"
          },
          {
            "name": "KAFKA_BROKER",
            "value": "kafka:29092"
          },
          {
            "name": "KAFKA_TOPIC",
            "value": "shipment-events"
          }
        ]
      }
    ]
  }