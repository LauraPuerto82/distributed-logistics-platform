{
    "family": "logistics-prediction-service",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "256",
    "memory": "512",
    "containerDefinitions": [
      {
        "name": "prediction-service",
        "image": "localhost:4566/distributed-logistics-prediction-service:latest",
        "essential": true,
        "environment": [
          {
            "name": "KAFKA_BROKER",
            "value": "kafka:29092"
          },
          {
            "name": "KAFKA_TOPIC",
            "value": "shipment-events"
          },
          {
            "name": "PYTHONUNBUFFERED",
            "value": "1"
          }
        ],
        "secrets": [
          {
            "name": "DATABASE_URL",
            "valueFrom": "__DATABASE_URL_SECRET_ARN__"
          }
        ]
      }
    ]
  }